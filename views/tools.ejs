<%- include('partials/header') %>

<%- include('partials/navbar') %>

<main class="flex-1">

    <section class="bg-gradient-to-br from-blue-600 via-indigo-600 to-violet-700 text-white">

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

            <div class="max-w-3xl">

                <span class="inline-flex px-3 py-1 rounded-full
                             bg-white/10 border border-white/20
                             text-sm mb-5">
                    🧰 Koleksi Tools
                </span>

                <h1 class="text-4xl md:text-5xl font-bold tracking-tight">
                    Semua Tools
                </h1>

                <p class="mt-5 text-lg text-blue-100">
                    Gunakan berbagai alat digital gratis untuk membantu
                    pekerjaan Anda.
                </p>

            </div>

        </div>

    </section>


    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">


            <!-- QR -->
            <a href="/tools/qr-code"
               class="tool-card">

                <div class="tool-icon bg-blue-100 text-blue-600">
                    ▣
                </div>

                <h2 class="tool-title">
                    QR Code Generator
                </h2>

                <p class="tool-description">
                    Buat QR Code dari URL, teks, nomor telepon,
                    atau informasi lainnya.
                </p>

                <span class="tool-link">
                    Buka Tool →
                </span>

            </a>


            <!-- Barcode -->
            <a href="/tools/barcode"
               class="tool-card">

                <div class="tool-icon bg-violet-100 text-violet-600">
                    ▥
                </div>

                <h2 class="tool-title">
                    Barcode Generator
                </h2>

                <p class="tool-description">
                    Buat barcode dengan cepat dari data yang Anda masukkan.
                </p>

                <span class="tool-link">
                    Buka Tool →
                </span>

            </a>


            <!-- PDF -->
            <a href="/tools/pdf-merge"
               class="tool-card">

                <div class="tool-icon bg-red-100 text-red-600">
                    📄
                </div>

                <h2 class="tool-title">
                    PDF Merge
                </h2>

                <p class="tool-description">
                    Gabungkan beberapa file PDF menjadi satu dokumen.
                </p>

                <span class="tool-link">
                    Buka Tool →
                </span>

            </a>


            <!-- Number -->
            <a href="/tools/number-to-text"
               class="tool-card">

                <div class="tool-icon bg-emerald-100 text-emerald-600">
                    123
                </div>

                <h2 class="tool-title">
                    Number to Text
                </h2>

                <p class="tool-description">
                    Konversikan angka menjadi tulisan bahasa Indonesia.
                </p>

                <span class="tool-link">
                    Buka Tool →
                </span>

            </a>


            <!-- TTS -->
            <a href="/tools/text-to-speech"
               class="tool-card">

                <div class="tool-icon bg-orange-100 text-orange-600">
                    🔊
                </div>

                <h2 class="tool-title">
                    Text to Speech
                </h2>

                <p class="tool-description">
                    Ubah teks menjadi suara langsung dari browser.
                </p>

                <span class="tool-link">
                    Buka Tool →
                </span>

            </a>


            <!-- Password -->
            <a href="/tools/password-generator"
               class="tool-card">

                <div class="tool-icon bg-slate-200 text-slate-700">
                    🔐
                </div>

                <h2 class="tool-title">
                    Password Generator
                </h2>

                <p class="tool-description">
                    Buat password acak yang kuat dan sulit ditebak.
                </p>

                <span class="tool-link">
                    Buka Tool →
                </span>

            </a>


            <!-- Background -->
            <a href="/tools/background-remover"
               class="tool-card">

                <div class="tool-icon bg-pink-100 text-pink-600">
                    🖼
                </div>

                <h2 class="tool-title">
                    Background Remover
                </h2>

                <p class="tool-description">
                    Hapus background gambar dengan mudah.
                </p>

                <span class="tool-link">
                    Buka Tool →
                </span>

            </a>

        </div>

    </section>

</main>

<%- include('partials/footer') %>