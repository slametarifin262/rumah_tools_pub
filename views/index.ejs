    <!-- SCRIPT JAVASCRIPT MODAL DONASI -->
    <script>
        let selectedAmount = 0;

        function openDonateModal() {
            const modal = document.getElementById('donateModal');
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
            }, 10);
        }

        function closeDonateModal() {
            const modal = document.getElementById('donateModal');
            modal.classList.add('opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 200);
        }

        function selectAmount(amount, element) {
            selectedAmount = amount;
            document.getElementById('customAmountInput').value = '';
            
            // Reset gaya tombol nominal
            document.querySelectorAll('.btn-amount').forEach(btn => {
                btn.classList.remove('border-amber-500', 'bg-amber-50', 'text-amber-700');
                btn.classList.add('border-slate-200', 'text-slate-700');
            });

            // Beri gaya aktif pada tombol yang dipilih
            if (element) {
                element.classList.remove('border-slate-200', 'text-slate-700');
                element.classList.add('border-amber-500', 'bg-amber-50', 'text-amber-700');
            }
        }

        function handleCustomAmount(val) {
            selectedAmount = parseInt(val) || 0;
            // Clear gaya tombol terpilih jika mengetik manual
            document.querySelectorAll('.btn-amount').forEach(btn => {
                btn.classList.remove('border-amber-500', 'bg-amber-50', 'text-amber-700');
                btn.classList.add('border-slate-200', 'text-slate-700');
            });
        }

        function processDonation() {
            const donorName = document.getElementById('donorNameInput').value.trim() || 'Hamba Allah';
            const bank = document.getElementById('bankSelect').value;

            if (selectedAmount <= 0) {
                alert('Silakan pilih atau ketik nominal dukungan terlebih dahulu.');
                return;
            }

            // Contoh simulasi pembuatan nomor Virtual Account
            const randomVA = Math.floor(1000000000000000 + Math.random() * 9000000000000000);
            const formattedAmount = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(selectedAmount);

            document.getElementById('vaNumber').textContent = randomVA;
            document.getElementById('vaAmountDisplay').textContent = `Total: ${formattedAmount} (${donorName})`;
            document.getElementById('vaResult').classList.remove('hidden');
        }

        function copyVA() {
            const vaNumber = document.getElementById('vaNumber').textContent;
            if (vaNumber && vaNumber !== '--') {
                navigator.clipboard.writeText(vaNumber).then(() => {
                    alert('Nomor VA berhasil disalin!');
                }).catch(err => {
                    alert('Gagal menyalin nomor VA');
                });
            }
        }
    </script> 
    <script>
    // Tentukan durasi jeda sebelum modal muncul kembali (dalam milidetik)
    // Contoh di bawah: 1 jam = 60 menit * 60 detik * 1000 ms = 3600000 ms
    // Jika ingin 30 menit, ubah menjadi: 30 * 60 * 1000
    const PROMO_COOLDOWN_TIME = 60 * 60 * 1000; // 1 Jam

    window.addEventListener('DOMContentLoaded', () => {
        const lastClosed = localStorage.getItem('promoClosedTime');
        const now = new Date().getTime();

        // Cek apakah waktu cooldown sudah lewat atau belum pernah ditutup
        if (!lastClosed || (now - lastClosed > PROMO_COOLDOWN_TIME)) {
            const modal = document.getElementById('promoModal');
            const content = document.getElementById('modalContent');
            
            modal.classList.remove('hidden');
            setTimeout(() => {
                content.classList.remove('scale-95', 'opacity-0');
                content.classList.add('scale-100', 'opacity-100');
            }, 50);
        }
    });

    function closePromoModal() {
        const modal = document.getElementById('promoModal');
        const content = document.getElementById('modalContent');
        
        content.classList.remove('scale-100', 'opacity-100');
        content.classList.add('scale-95', 'opacity-0');
        
        setTimeout(() => {
            modal.classList.add('hidden');
            // Simpan waktu saat ini ke localStorage saat modal ditutup
            localStorage.setItem('promoClosedTime', new Date().getTime());
        }, 300);
    }
</script>
