<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur-xl dark:border-slate-800 dark:bg-slate-950/90">

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="h-16 flex items-center justify-between">

            <!-- Logo -->
            <a href="/" class="flex items-center gap-3 group">

                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-indigo-600
                            flex items-center justify-center text-white font-bold shadow-lg
                            shadow-blue-500/20 group-hover:scale-105 transition">

                    RT
                </div>

                <div>
                    <div class="font-bold text-lg tracking-tight">
                        Rumah Tools
                    </div>

                    <div class="hidden sm:block text-xs text-slate-500 dark:text-slate-400">
                        Digital tools sederhana
                    </div>
                </div>

            </a>


            <!-- Desktop Navigation -->
            <nav class="hidden md:flex items-center gap-1">

                <a href="/"
                   class="px-4 py-2 rounded-lg text-sm font-medium
                          hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                    Beranda
                </a>

                <a href="/tools"
                   class="px-4 py-2 rounded-lg text-sm font-medium
                          hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                    Semua Tools
                </a>

            </nav>


            <!-- Actions -->
            <div class="flex items-center gap-2">

                <button
                    onclick="toggleDarkMode()"
                    class="w-10 h-10 rounded-xl border border-slate-200
                           dark:border-slate-700 flex items-center justify-center
                           hover:bg-slate-100 dark:hover:bg-slate-800 transition"
                    aria-label="Toggle dark mode">

                    <span id="themeIcon">🌙</span>

                </button>

                <button
                    onclick="toggleMobileMenu()"
                    class="md:hidden w-10 h-10 rounded-xl
                           hover:bg-slate-100 dark:hover:bg-slate-800">

                    ☰

                </button>

            </div>

        </div>


        <!-- Mobile Menu -->
        <div id="mobileMenu" class="hidden md:hidden pb-4">

            <div class="border-t border-slate-200 dark:border-slate-800 pt-3 space-y-1">

                <a href="/"
                   class="block px-4 py-3 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800">
                    Beranda
                </a>

                <a href="/tools"
                   class="block px-4 py-3 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800">
                    Semua Tools
                </a>

            </div>

        </div>

    </div>

</header>