<aside class="w-full md:w-64 shrink-0">
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm p-4 md:sticky md:top-24">

        <div class="flex items-center gap-3 mb-4 pb-4 border-b border-slate-100 dark:border-slate-800">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-indigo-600
                        flex items-center justify-center text-white font-bold shrink-0">
                <%= (user && user.name) ? user.name.charAt(0).toUpperCase() : '?' %>
            </div>
            <div class="min-w-0">
                <div class="text-sm font-semibold truncate"><%= user ? user.name : '' %></div>
                <div class="text-xs text-slate-500 dark:text-slate-400">
                    <%= (user && user.role === 'admin') ? 'Administrator' : 'Pengguna' %>
                </div>
            </div>
        </div>

        <nav class="space-y-1 text-sm">
            <a href="/dashboard/api-key"
               class="flex items-center gap-2 px-3 py-2 rounded-lg font-medium transition <%= (typeof active !== 'undefined' && active === 'api') ? 'bg-blue-50 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                <span>🔑</span> Dashboard API
            </a>
            <a href="/dashboard/riwayat"
               class="flex items-center gap-2 px-3 py-2 rounded-lg font-medium transition <%= (typeof active !== 'undefined' && active === 'riwayat') ? 'bg-blue-50 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                <span>🕓</span> Riwayat Penggunaan
            </a>
            <a href="/tools/kasir"
               class="flex items-center gap-2 px-3 py-2 rounded-lg font-medium transition <%= (typeof active !== 'undefined' && active === 'kasir') ? 'bg-blue-50 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                <span>🧮</span> Kasir
            </a>
            <a href="/dashboard/repositori"
               class="flex items-center gap-2 px-3 py-2 rounded-lg font-medium transition <%= (typeof active !== 'undefined' && active === 'repositori') ? 'bg-blue-50 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                <span>🗄️</span> Repositori Aplikasi
            </a>
            <% if (user && user.role === 'admin') { %>
            <a href="/dashboard/analytics"
               class="flex items-center gap-2 px-3 py-2 rounded-lg font-medium transition <%= (typeof active !== 'undefined' && active === 'analytics') ? 'bg-blue-50 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800' %>">
                <span>📊</span> Analitik Fitur
            </a>
            <% } %>
        </nav>

        <div class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-800">
            <a href="/logout"
               class="flex items-center gap-2 px-3 py-2 rounded-lg font-medium text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 transition">
                <span>🚪</span> Keluar
            </a>
        </div>

    </div>
</aside>
