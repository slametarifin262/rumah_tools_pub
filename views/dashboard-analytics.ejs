<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col md:flex-row gap-6">
    <%- include('partials/sidebar', { active: 'analytics' }) %>

    <main class="flex-1 min-w-0">

        <div class="mb-6">
            <h1 class="text-2xl font-bold">Analitik Fitur</h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                Statistik pemakaian tiap fitur (tamu &amp; user login) untuk bahan analisa kebermanfaatan dari
                sisi bisnis. Data ini anonim &mdash; tidak berisi identitas pengguna.
            </p>
        </div>

        <div class="flex gap-2 mb-6 flex-wrap">
            <a href="?periode=today"
               class="text-xs font-semibold px-3 py-1.5 rounded-lg transition <%= periode === 'today' ? 'bg-blue-600 text-white' : 'border border-blue-300 text-blue-600 dark:border-blue-800 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-900/20' %>">Hari Ini</a>
            <a href="?periode=7d"
               class="text-xs font-semibold px-3 py-1.5 rounded-lg transition <%= periode === '7d' ? 'bg-blue-600 text-white' : 'border border-blue-300 text-blue-600 dark:border-blue-800 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-900/20' %>">7 Hari</a>
            <a href="?periode=30d"
               class="text-xs font-semibold px-3 py-1.5 rounded-lg transition <%= periode === '30d' ? 'bg-blue-600 text-white' : 'border border-blue-300 text-blue-600 dark:border-blue-800 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-900/20' %>">30 Hari</a>
            <a href="?periode=all"
               class="text-xs font-semibold px-3 py-1.5 rounded-lg transition <%= periode === 'all' ? 'bg-blue-600 text-white' : 'border border-blue-300 text-blue-600 dark:border-blue-800 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-900/20' %>">Semua</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
            <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800
                        shadow-sm p-4 border-l-4 border-l-blue-500">
                <div class="text-xs font-semibold uppercase text-slate-500 dark:text-slate-400">Total Pemakaian</div>
                <div class="text-3xl font-bold mt-1"><%= summary.total || 0 %></div>
            </div>
            <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800
                        shadow-sm p-4 border-l-4 border-l-emerald-500">
                <div class="text-xs font-semibold uppercase text-slate-500 dark:text-slate-400">Dari User Login</div>
                <div class="text-3xl font-bold mt-1 text-emerald-600 dark:text-emerald-400"><%= summary.total_login || 0 %></div>
            </div>
            <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800
                        shadow-sm p-4 border-l-4 border-l-slate-400">
                <div class="text-xs font-semibold uppercase text-slate-500 dark:text-slate-400">Dari Tamu (Guest)</div>
                <div class="text-3xl font-bold mt-1 text-slate-600 dark:text-slate-300"><%= summary.total_guest || 0 %></div>
            </div>
            <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800
                        shadow-sm p-4 border-l-4 border-l-sky-500">
                <div class="text-xs font-semibold uppercase text-slate-500 dark:text-slate-400">Jumlah Fitur Dipakai</div>
                <div class="text-3xl font-bold mt-1"><%= summary.total_fitur_dipakai || 0 %></div>
            </div>
        </div>

        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm mb-6 overflow-hidden">
            <div class="px-5 py-4 border-b border-slate-100 dark:border-slate-800">
                <h2 class="font-bold">Kebermanfaatan Per Fitur</h2>
            </div>
            <% if (perTool && perTool.length > 0) { %>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-slate-50 dark:bg-slate-800/60 text-left text-xs uppercase text-slate-500 dark:text-slate-400">
                        <tr>
                            <th class="px-5 py-3">Fitur</th>
                            <th class="px-5 py-3">Total Pemakaian</th>
                            <th class="px-5 py-3 w-56">Login vs Tamu</th>
                            <th class="px-5 py-3">Login</th>
                            <th class="px-5 py-3">Tamu</th>
                            <th class="px-5 py-3">Gagal</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                        <% perTool.forEach(t => { %>
                            <% const loginPct = t.total > 0 ? Math.round((t.total_login / t.total) * 100) : 0; %>
                            <tr>
                                <td class="px-5 py-3 font-semibold">
                                    <%= t.tool_name %>
                                    <span class="text-xs font-normal text-slate-500 dark:text-slate-400">(<%= t.tool_slug %>)</span>
                                </td>
                                <td class="px-5 py-3 font-bold"><%= t.total %></td>
                                <td class="px-5 py-3">
                                    <div class="h-2 rounded-full overflow-hidden bg-slate-100 dark:bg-slate-800 flex">
                                        <div class="h-full bg-blue-600" style="width: <%= loginPct %>%;"></div>
                                        <div class="h-full bg-slate-400" style="width: <%= 100 - loginPct %>%;"></div>
                                    </div>
                                </td>
                                <td class="px-5 py-3 text-emerald-600 dark:text-emerald-400"><%= t.total_login %></td>
                                <td class="px-5 py-3 text-slate-500 dark:text-slate-400"><%= t.total_guest %></td>
                                <td class="px-5 py-3 <%= t.total_gagal > 0 ? 'text-red-600 dark:text-red-400 font-semibold' : 'text-slate-400' %>"><%= t.total_gagal %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
            <div class="text-center py-10 px-4">
                <div class="text-4xl mb-2">📊</div>
                <h3 class="font-bold text-slate-600 dark:text-slate-300">Belum ada data pemakaian pada periode ini</h3>
            </div>
            <% } %>
        </div>

        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm p-5">
            <h2 class="font-bold mb-4">Tren 14 Hari Terakhir (Semua Fitur)</h2>
            <% if (harian && harian.length > 0) { %>
                <% const maxHarian = Math.max(...harian.map(h => h.total)); %>
                <div class="flex items-end gap-2" style="height: 140px;">
                    <% harian.forEach(h => { %>
                        <% const heightPct = maxHarian > 0 ? Math.max(4, Math.round((h.total / maxHarian) * 100)) : 4; %>
                        <div class="flex flex-col items-center flex-1">
                            <div class="text-xs text-slate-500 dark:text-slate-400 mb-1"><%= h.total %></div>
                            <div class="w-full bg-blue-600 rounded-t" style="height: <%= heightPct %>%;"></div>
                            <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                                <%= new Date(h.tanggal).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit' }) %>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
            <p class="text-sm text-slate-500 dark:text-slate-400 text-center py-4">Belum ada data.</p>
            <% } %>
        </div>

    </main>
</div>

<%- include('partials/footer') %>
