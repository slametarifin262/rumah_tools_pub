<script>
    // Variabel global
    let selectedDonationAmount = 0;
    let currentActiveVA = "";

    // Format Angka ke Format Rupiah (e.g. 100000 -> "Rp 100.000")
    function formatRupiah(amount) {
        return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(amount);
    }

    function openDonateModal() {
        const modal = document.getElementById('donateModal');
        modal.classList.remove('hidden');
        setTimeout(() => modal.classList.remove('opacity-0'), 10);
    }

    function closeDonateModal() {
        const modal = document.getElementById('donateModal');
        modal.classList.add('opacity-0');
        setTimeout(() => modal.classList.add('hidden'), 200);
    }

    function selectAmount(amount, element) {
        selectedDonationAmount = amount;

        // Isi nilai ke input custom
        const customAmountInput = document.getElementById('customAmountInput');
        if (customAmountInput) {
            customAmountInput.value = amount;
        }

        // Mengubah tampilan tombol yang diklik
        if (element) {
            document.querySelectorAll('.btn-amount').forEach(btn => {
                btn.className = "btn-amount border border-slate-200 hover:border-amber-500 py-2.5 px-2 rounded-xl text-xs font-semibold text-slate-700 transition flex items-center justify-center gap-1";
                const icon = btn.querySelector('.fa-check');
                if (icon) icon.remove();
            });

            element.className = "btn-amount border-2 border-amber-500 bg-amber-50 py-2.5 px-2 rounded-xl text-xs font-bold text-amber-700 shadow-sm transition flex items-center justify-center gap-1";
            
            const checkIcon = document.createElement('i');
            checkIcon.className = "fa-solid fa-check text-[10px] text-amber-600";
            element.prepend(checkIcon);
        }
    }

    function handleCustomAmount(value) {
        if (value && parseInt(value) > 0) {
            selectedDonationAmount = parseInt(value);
            
            document.querySelectorAll('.btn-amount').forEach(btn => {
                btn.className = "btn-amount border border-slate-200 hover:border-amber-500 py-2.5 px-2 rounded-xl text-xs font-semibold text-slate-700 transition flex items-center justify-center gap-1";
                const icon = btn.querySelector('.fa-check');
                if (icon) icon.remove();
            });
        }
    }
    // 1. FUNGSI UNTUK MENGIRIM DONASI & MEMANGGIL MODAL
    async function generateVA(event) {
        if (event) event.preventDefault();

        // 1. Ambil nilai dari input form
        const amountInput = document.getElementById('customAmountInput')?.value || '';
        const donorName = document.getElementById('donorNameInput')?.value || 'Hamba Allah';
        const bank = document.getElementById('bankSelect')?.value || 'BCA';

        // Bersihkan format non-angka
        const cleanAmount = parseInt(String(amountInput).replace(/[^0-9]/g, ''), 10);

        if (!cleanAmount || isNaN(cleanAmount) || cleanAmount <= 0) {
            alert('Masukkan nominal donasi yang valid.');
            return;
        }

        try {
            // 2. Kirim data donasi ke server
            const response = await fetch('/api/donations/create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    name: donorName,
                    amount: cleanAmount,
                    bank: bank
                })
            });

            const result = await response.json();

            // 3. DI SINI DIPANGGIL: Saat respon dari server menyatakan sukses
            if (result.success) {
                // 🔴 PANGGIL showVaModal DENGAN MEMBAWA DATA DARI SERVER 🔴
                // alert(result.vaNumber+':'+result.amount);
                showVaModal(result.vaNumber, result.amount);
            } else {
                alert('Gagal membuat VA: ' + result.message);
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Terjadi kesalahan koneksi ke server.');
        }
    }

    // Fungsi showVaModal itu sendiri bertugas mengisi teks & menampilkan modal

    let currentVaNumber = '';
    function showVaModal(vaNumber, amount) {
        alert(vaNumber+'>>'+ amount);
        // Isi data ke dalam elemen HTML modal
        document.getElementById('vaNumber_sim').innerText = vaNumber;
        document.getElementById('vaAmountDisplay_sim').innerText = `Total: Rp ${Number(amount).toLocaleString('id-ID')}`;
        currentActiveVA = vaNumber;

        // Tampilkan Modal (Ubah class hidden menjadi flex)
        const modal = document.getElementById('vaModal');
        if (modal) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }
    }
    // Fungsi Menambahkan Donatur ke Ticker Berjalan secara Dinamis
    function appendDonorToTicker(name, amount, status, vaNumber) {
        const marqueeContainer = document.querySelector('.animate-marquee');
        if (!marqueeContainer) return;

        const donorCard = document.createElement('div');
        if (vaNumber) {
            donorCard.setAttribute('data-va', vaNumber);
        }

        if (status === 0) {
            donorCard.className = "donor-item flex items-center gap-2 bg-slate-800/30 px-3 py-1 rounded-full border border-slate-700/30 opacity-60 text-slate-400 transition-all";
            donorCard.innerHTML = `
                <i class="fa-solid fa-clock text-slate-400 text-xs"></i>
                <span>${name}</span>
                <span class="text-slate-500 font-mono text-[10px]">(Rp ${amount.toLocaleString('id-ID')} <span class="status-text">- Menunggu</span>)</span>
            `;
        } else {
            donorCard.className = "donor-item flex items-center gap-2 bg-slate-800/80 px-3 py-1 rounded-full border border-slate-700/80 shadow-sm transition-all";
            donorCard.innerHTML = `
                <i class="fa-solid fa-circle-check text-emerald-400 text-xs"></i>
                <span class="text-slate-200 font-bold">${name}</span>
                <span class="text-emerald-400 font-mono text-[10px]">(${formatRupiah(amount)})</span>
            `;
        }

        marqueeContainer.prepend(donorCard);
    }

    function copyVA() {
        const vaText = document.getElementById('vaNumber').innerText;
        navigator.clipboard.writeText(vaText);
        alert("Nomor Virtual Account berhasil disalin!");
    }
    // Fungsi Tutup Modal
    function closeVaModal() {
        const modal = document.getElementById('vaModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }
    async function simulatePayment() {
        // Ambil nilai VA langsung dari teks elemen HTML jika variabel global kosong
        const vaToPay = currentActiveVA || document.getElementById('vaNumber')?.innerText?.trim();

        if (!vaToPay) {
            alert("Nomor VA tidak ditemukan!");
            return;
        }

        try {
            // CATATAN: ini tombol simulasi (dummy) untuk testing tanpa payment gateway asli.
            // Endpoint /api/donations/simulate TERPISAH dari /api/donations/webhook (yang asli),
            // dan dilindungi CSRF token (bukan secret webhook) karena dipanggil dari browser.
            const response = await fetch('/api/donations/simulate', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ va_number: vaToPay })
            });

            const result = await response.json();

            if (result.success) {
                alert("🎉 Pembayaran Berhasil! Status telah diubah menjadi Terbayar.");
                closeVaModal();
                location.reload(); // Refresh halaman untuk melihat status terbaru
            } else {
                alert("Gagal memperbarui status: " + result.message);
            }
        } catch (error) {
            console.error("Error simulasi:", error);
            alert("Terjadi kesalahan saat memproses pembayaran.");
        }
    }

    function updateTickerUI(vaNumber) {
        const donorElement = document.querySelector(`[data-va="${vaNumber}"]`);
        if (donorElement) {
            donorElement.className = "donor-item flex items-center gap-2 bg-slate-800/80 px-3 py-1 rounded-full border border-slate-700/80 text-slate-200 font-semibold shadow-sm transition-all";
            
            const icon = donorElement.querySelector('i');
            if (icon) icon.className = "fa-solid fa-circle-check text-emerald-400 text-xs";

            const statusSpan = donorElement.querySelector('.status-text');
            if (statusSpan) statusSpan.remove();
        }
    }
</script>
</body>
</html>