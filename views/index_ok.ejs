    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title>RumahTools - Solusi Utilitas & Alat Digital Anda</title>
    <!-- Tailwind CSS CDN -->
    <script src="/assets/js/csrf.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Font Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style> 
        body { font-family: 'Inter', sans-serif; }

        /* Keyframe untuk Running Ticker / Marquee */
        @keyframes marquee {
            0% { transform: translateX(0%); }
            100% { transform: translateX(-50%); }
        }
        .animate-marquee {
            display: flex;
            width: max-content;
            animation: marquee 25s linear infinite;
        }
        .animate-marquee:hover {
            animation-play-state: paused; /* Berhenti sejenak saat kursor hover */
        }
    </style>
</head>
<body class="bg-slate-950 antialiased">

    <!-- ======================================================== -->
    <!-- 1. HERO / BANNER FIXATED DI BACKGROUND (Tanpa Blur)      -->
    <!-- ======================================================== -->
    <header class="fixed top-0 left-0 w-full h-screen z-0 flex items-center justify-center bg-cover bg-center"
