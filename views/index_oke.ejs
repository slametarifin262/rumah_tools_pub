                        <i class="fa-solid fa-user-ninja text-amber-400 text-xs"></i>
                        <span>Hamba Allah <span class="text-emerald-400 font-mono text-[10px] ml-1">(Rp 100.000)</span></span>
                    </div>

                    <div class="flex items-center gap-2 bg-slate-800/60 px-3 py-1 rounded-full border border-slate-700/50">
                        <i class="fa-solid fa-rocket text-indigo-400 text-xs"></i>
                        <span class="font-bold text-slate-200">TechLab Ventures</span>
                    </div>

