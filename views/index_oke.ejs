    <!-- RUNNING TICKER / MARQUEE SPONSOR & DONATUR -->
    <section class="bg-slate-900 text-slate-300 py-2.5 overflow-hidden border-b border-slate-800 relative shadow-inner">
        <div class="flex items-center max-w-7xl mx-auto">
            
            <!-- Label Tetap di Sisi Kiri -->
            <div class="z-10 bg-slate-900 px-4 flex items-center gap-2 text-[11px] font-bold text-amber-400 uppercase tracking-wider shrink-0 border-r border-slate-800">
                <i class="fa-solid fa-heart animate-pulse"></i>
                <span class="hidden sm:inline">Pendukung & Investor:</span>
            </div>

            <!-- Area Teks Berjalan (Infinite Loop) -->
            <div class="overflow-hidden w-full relative">
                <div class="animate-marquee flex items-center gap-8 text-xs font-medium">
                     <% if (typeof donations !== 'undefined' && donations.length > 0) { %>
                    <% donations.forEach(donor => { %>
                        <% if (donor.status === 0) { %>
                            <!-- Status 0: Menunggu Pembayaran (Warna Abu-abu / Muted) -->
                            <div class="flex items-center gap-2 bg-slate-800/30 px-3 py-1 rounded-full border border-slate-700/30 opacity-60 text-slate-400">
                                <i class="fa-solid fa-clock text-slate-400 text-xs"></i>
                                <span><%= donor.donor_name || donor.name %></span>
                                <span class="text-slate-500 font-mono text-[10px]">(Rp <%= Number(donor.amount).toLocaleString('id-ID') %> - Menunggu)</span>
                            </div>
                        <% } else { %>
                            <!-- Status 1: Sudah Transfer (Warna Normal / Bright) -->
                            <div class="flex items-center gap-2 bg-slate-800/80 px-3 py-1 rounded-full border border-slate-700/80 text-slate-200 font-semibold">
                                <i class="fa-solid fa-circle-check text-emerald-400 text-xs"></i>
                                <span><%= donor.donor_name || donor.name %></span>
                                <span class="text-emerald-400 font-mono text-[10px]">(Rp <%= Number(donor.amount).toLocaleString('id-ID') %>)</span>
                            </div>
                        <% } %>
                    <% }); %>
                <% } else { %>
                    <!-- Tampilan default jika belum ada data donasi di MySQL -->
                    <span class="text-slate-500 italic text-xs">Belum ada aktivitas donasi.</span>
                <% } %>
                <!-- </div> -->
<!-- <div class="animate-marquee flex items-center gap-8 text-xs font-medium"> -->
                    
                    <!-- SET 1 (Dummy Data) -->
