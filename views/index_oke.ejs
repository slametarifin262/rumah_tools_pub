    async function simulatePayment() {
        // Ambil nilai VA langsung dari teks elemen HTML jika variabel global kosong
        const vaToPay = currentActiveVA || document.getElementById('vaNumber')?.innerText?.trim();

        if (!vaToPay) {
            alert("Nomor VA tidak ditemukan!");
            return;
        }

        try {
            const response = await fetch('/api/donations/webhook', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ va_number: vaToPay })
            });

            const result = await response.json();

            if (result.success) {
                alert("🎉 Pembayaran Berhasil! Status telah diubah menjadi Terbayar.");
                closeVaModal();
                location.reload(); // Refresh halaman untuk melihat status terbaru
            } else {
                alert("Gagal memperbarui status: " + result.message);
            }
        } catch (error) {
            console.error("Error simulasi:", error);
            alert("Terjadi kesalahan saat memproses pembayaran.");
        }
    }

    function updateTickerUI(vaNumber) {
        const donorElement = document.querySelector(`[data-va="${vaNumber}"]`);
        if (donorElement) {
            donorElement.className = "donor-item flex items-center gap-2 bg-slate-800/80 px-3 py-1 rounded-full border border-slate-700/80 text-slate-200 font-semibold shadow-sm transition-all";
            
            const icon = donorElement.querySelector('i');
            if (icon) icon.className = "fa-solid fa-circle-check text-emerald-400 text-xs";

            const statusSpan = donorElement.querySelector('.status-text');
            if (statusSpan) statusSpan.remove();
        }
    }
</script>

</body>
</html>