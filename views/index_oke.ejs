        document.getElementById('vaAmountDisplay_sim').innerText = `Total: Rp ${Number(amount).toLocaleString('id-ID')}`;
        currentActiveVA = vaNumber;

        // Tampilkan Modal (Ubah class hidden menjadi flex)
        const modal = document.getElementById('vaModal');
        if (modal) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }
    }
    // Fungsi Menambahkan Donatur ke Ticker Berjalan secara Dinamis
    function appendDonorToTicker(name, amount, status, vaNumber) {
        const marqueeContainer = document.querySelector('.animate-marquee');
        if (!marqueeContainer) return;

        const donorCard = document.createElement('div');
        if (vaNumber) {
            donorCard.setAttribute('data-va', vaNumber);
        }

        if (status === 0) {
            donorCard.className = "donor-item flex items-center gap-2 bg-slate-800/30 px-3 py-1 rounded-full border border-slate-700/30 opacity-60 text-slate-400 transition-all";
            donorCard.innerHTML = `
                <i class="fa-solid fa-clock text-slate-400 text-xs"></i>
                <span>${name}</span>
                <span class="text-slate-500 font-mono text-[10px]">(Rp ${amount.toLocaleString('id-ID')} <span class="status-text">- Menunggu</span>)</span>
            `;
        } else {
            donorCard.className = "donor-item flex items-center gap-2 bg-slate-800/80 px-3 py-1 rounded-full border border-slate-700/80 shadow-sm transition-all";
            donorCard.innerHTML = `
                <i class="fa-solid fa-circle-check text-emerald-400 text-xs"></i>
                <span class="text-slate-200 font-bold">${name}</span>
                <span class="text-emerald-400 font-mono text-[10px]">(${formatRupiah(amount)})</span>
            `;
        }

        marqueeContainer.prepend(donorCard);
    }

