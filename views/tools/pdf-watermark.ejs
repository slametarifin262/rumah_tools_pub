<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="py-8 bg-gray-50 min-h-screen">
    <div class="w-full lg:w-3/4 max-w-5xl mx-auto px-4">
        
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8 mb-6">
            <h1 class="text-2xl font-bold text-gray-900 mb-1">Tambah Watermark PDF Custom</h1>
            <p class="text-sm text-gray-500 mb-6">Tambahkan teks "SALINAN" di tengah halaman atau label "DOKUMEN RAHASIA" di pojok dengan pilihan warna & transparansi kustom.</p>

            <form id="watermarkForm" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <!-- Upload Zone -->
                <div 
                    id="dropZone"
                    class="border-2 border-dashed border-gray-300 hover:border-amber-800 rounded-2xl p-6 text-center bg-gray-50 hover:bg-amber-50/20 transition cursor-pointer mb-6"
                >
                    <svg class="mx-auto h-10 w-10 text-gray-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                    </svg>
                    <p id="fileName" class="text-sm font-semibold text-gray-700 mb-1">Klik atau seret file PDF Anda ke sini</p>
                    <p class="text-xs text-gray-400">Format yang didukung: .PDF (Maksimal 15MB)</p>
                    
                    <input 
                        type="file" 
                        name="pdf_file" 
                        id="pdfInput" 
                        accept="application/pdf" 
                        required 
                        class="hidden"
                    >
                </div>

                <!-- Pengaturan Watermark Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                    
                    <!-- Form Kiri: Teks & Posisi -->
                    <div class="space-y-4">
                        <div>
                            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Teks Tengah (Diagonal / Background):</label>
                            <input 
                                type="text" 
                                name="center_text" 
                                placeholder="Contoh: SALINAN / DRAFT / SAMPLE" 
                                value="SALINAN"
                                class="w-full px-4 py-2.5 rounded-xl border border-gray-300 text-sm text-gray-900 bg-white focus:outline-none focus:border-amber-800"
                            >
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Teks Pojok / Label Catatan:</label>
                            <input 
                                type="text" 
                                name="corner_text" 
                                placeholder="Contoh: DOKUMEN RAHASIA" 
                                value="DOKUMEN RAHASIA"
                                class="w-full px-4 py-2.5 rounded-xl border border-gray-300 text-sm text-gray-900 bg-white focus:outline-none focus:border-amber-800"
                            >
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Posisi Teks Pojok:</label>
                            <select name="corner_position" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 text-sm text-gray-900 bg-white focus:outline-none focus:border-amber-800">
                                <option value="top-right" selected>Pojok Kanan Atas</option>
                                <option value="top-left">Pojok Kiri Atas</option>
                                <option value="bottom-right">Pojok Kanan Bawah</option>
                                <option value="bottom-left">Pojok Kiri Bawah</option>
                            </select>
                        </div>
                    </div>

                    <!-- Form Kanan: Warna & Transparansi -->
                    <div class="space-y-4">
                        <div>
                            <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Pilih Warna Watermark:</label>
                            <div class="flex items-center gap-3">
                                <input type="color" id="textColor" name="text_color" value="#dc2626" class="w-10 h-10 rounded border-0 cursor-pointer shadow-sm bg-transparent">
                                <div class="flex flex-wrap gap-2">
                                    <button type="button" onclick="setColor('#dc2626')" class="w-7 h-7 rounded-full bg-red-600 border border-gray-200" title="Merah"></button>
                                    <button type="button" onclick="setColor('#2563eb')" class="w-7 h-7 rounded-full bg-blue-600 border border-gray-200" title="Biru"></button>
                                    <button type="button" onclick="setColor('#6b7280')" class="w-7 h-7 rounded-full bg-gray-500 border border-gray-200" title="Abu-abu"></button>
                                    <button type="button" onclick="setColor('#000000')" class="w-7 h-7 rounded-full bg-black border border-gray-200" title="Hitam"></button>
                                </div>
                            </div>
                        </div>

                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <label class="text-xs font-bold text-gray-700 uppercase">Transparansi (Opacity):</label>
                                <span id="opacityVal" class="text-xs font-semibold text-gray-700">30%</span>
                            </div>
                            <input 
                                type="range" 
                                name="opacity" 
                                min="0.1" 
                                max="0.9" 
                                step="0.05" 
                                value="0.3"
                                oninput="document.getElementById('opacityVal').innerText = Math.round(this.value * 100) + '%'"
                                class="w-full accent-amber-800"
                            >
                            <p class="text-[11px] text-gray-500 mt-1">Gunakan transparansi rendah (20-30%) agar teks dokumen asli tetap terlihat jelas.</p>
                        </div>
                    </div>

                </div>

                <button 
                    type="submit" 
                    id="processBtn"
                    class="w-full bg-amber-800 hover:bg-amber-900 text-white font-semibold text-sm py-3 px-6 rounded-xl transition shadow-sm disabled:bg-gray-300 disabled:cursor-not-allowed"
                    disabled
                >
                    Proses Watermark PDF
                </button>
            </form>

            <!-- Loading Spinner -->
            <div id="loadingState" class="hidden text-center py-8">
                <div class="inline-block animate-spin rounded-full h-10 w-10 border-4 border-amber-800 border-t-transparent mb-3"></div>
                <p class="text-sm font-semibold text-gray-700">Sedang menambahkan watermark pada PDF Anda...</p>
            </div>
        </div>

        <!-- Section Preview PDF Hasil -->
        <div id="resultContainer" class="hidden bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8">
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-4">
                <h2 class="text-lg font-bold text-gray-900">Hasil Watermark PDF</h2>
                <a 
                    id="downloadBtn" 
                    href="#" 
                    download="dokumen_watermark.pdf" 
                    class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm py-2.5 px-6 rounded-xl transition shadow-sm flex items-center gap-2"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                    Download PDF
                </a>
            </div>

            <!-- Frame PDF Preview -->
            <div class="w-full h-[600px] border border-gray-200 rounded-xl overflow-hidden bg-gray-100">
                <iframe id="pdfPreview" class="w-full h-full"></iframe>
            </div>
        </div>

    </div>
</main>

<script>
    const dropZone = document.getElementById('dropZone');
    const pdfInput = document.getElementById('pdfInput');
    const fileName = document.getElementById('fileName');
    const processBtn = document.getElementById('processBtn');
    const watermarkForm = document.getElementById('watermarkForm');
    const loadingState = document.getElementById('loadingState');
    const resultContainer = document.getElementById('resultContainer');
    const pdfPreview = document.getElementById('pdfPreview');
    const downloadBtn = document.getElementById('downloadBtn');
    const textColor = document.getElementById('textColor');

    dropZone.addEventListener('click', () => pdfInput.click());

    pdfInput.addEventListener('change', () => {
        const file = pdfInput.files[0];
        if (file) {
            fileName.innerText = `File Terpilih: ${file.name}`;
            processBtn.disabled = false;
        } else {
            fileName.innerText = 'Klik atau seret file PDF Anda ke sini';
            processBtn.disabled = true;
        }
    });

    function setColor(hex) {
        textColor.value = hex;
    }

    watermarkForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const formData = new FormData(watermarkForm);

        loadingState.classList.remove('hidden');
        resultContainer.classList.add('hidden');
        processBtn.disabled = true;

        try {
            const response = await fetch('/tools/pdf-watermark', {
                method: 'POST',
                body: formData
            });

            const data = await response.json();

            if (data.success) {
                pdfPreview.src = data.pdfDataUrl;
                downloadBtn.href = data.pdfDataUrl;
                resultContainer.classList.remove('hidden');
                resultContainer.scrollIntoView({ behavior: 'smooth' });
            } else {
                alert(data.error || 'Gagal memproses PDF.');
            }
        } catch (err) {
            console.error(err);
            alert('Terjadi kesalahan koneksi saat mengolah PDF.');
        } finally {
            loadingState.classList.add('hidden');
            processBtn.disabled = false;
        }
    });
</script>

<%- include('../partials/footer') %>