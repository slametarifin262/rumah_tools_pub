<%- include('../partials/header') %>

<%- include('../partials/navbar') %>

<main class="flex-1">

    <!-- HERO -->

    <section class="bg-gradient-to-br from-emerald-600 via-teal-600 to-cyan-700 text-white">

        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">

            <a href="/tools"
               class="text-sm text-emerald-100 hover:text-white">

                ← Kembali ke Semua Tools

            </a>


            <div class="mt-8 flex items-start gap-5">

                <div class="w-16 h-16 rounded-2xl
                            bg-white/15
                            flex items-center justify-center
                            text-3xl">

                    🔐

                </div>


                <div>

                    <h1 class="text-3xl md:text-4xl font-bold">

                        Password Generator

                    </h1>


                    <p class="mt-3 text-emerald-100 max-w-2xl">

                        Buat password acak yang kuat dan aman
                        langsung di perangkat Anda.

                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- TOOL -->

    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14">

        <div class="grid lg:grid-cols-5 gap-6">


            <!-- SETTINGS -->

            <div class="lg:col-span-3">

                <div class="bg-white dark:bg-slate-900
                            border border-slate-200 dark:border-slate-800
                            rounded-2xl shadow-sm p-6 md:p-8">


                    <h2 class="text-xl font-bold">

                        Pengaturan Password

                    </h2>


                    <!-- LENGTH -->

                    <div class="mt-6">

                        <div class="flex justify-between">

                            <label
                                class="font-semibold text-sm">

                                Panjang Password

                            </label>


                            <span
                                id="lengthValue"
                                class="font-bold text-emerald-600">

                                16

                            </span>

                        </div>


                        <input
                            id="passwordLength"
                            type="range"
                            min="8"
                            max="64"
                            value="16"
                            class="w-full mt-4 accent-emerald-600">

                    </div>


                    <!-- OPTIONS -->

                    <div class="mt-8 space-y-4">


                        <label class="flex items-center gap-3 cursor-pointer">

                            <input
                                id="uppercase"
                                type="checkbox"
                                checked
                                class="w-5 h-5 accent-emerald-600">

                            <span>

                                Huruf besar

                                <span class="text-slate-400">
                                    (A-Z)
                                </span>

                            </span>

                        </label>


                        <label class="flex items-center gap-3 cursor-pointer">

                            <input
                                id="lowercase"
                                type="checkbox"
                                checked
                                class="w-5 h-5 accent-emerald-600">

                            <span>

                                Huruf kecil

                                <span class="text-slate-400">
                                    (a-z)
                                </span>

                            </span>

                        </label>


                        <label class="flex items-center gap-3 cursor-pointer">

                            <input
                                id="numbers"
                                type="checkbox"
                                checked
                                class="w-5 h-5 accent-emerald-600">

                            <span>

                                Angka

                                <span class="text-slate-400">
                                    (0-9)
                                </span>

                            </span>

                        </label>


                        <label class="flex items-center gap-3 cursor-pointer">

                            <input
                                id="symbols"
                                type="checkbox"
                                checked
                                class="w-5 h-5 accent-emerald-600">

                            <span>

                                Simbol

                                <span class="text-slate-400">
                                    (!@#$...)
                                </span>

                            </span>

                        </label>

                    </div>


                    <p
                        id="passwordError"
                        class="hidden mt-5 text-sm text-red-500">
                    </p>


                    <button
                        id="generatePasswordBtn"
                        class="w-full mt-8 px-5 py-3 rounded-xl
                               bg-emerald-600
                               text-white
                               font-semibold
                               hover:bg-emerald-700
                               transition">

                        Generate Password

                    </button>

                </div>

            </div>


            <!-- RESULT -->

            <div class="lg:col-span-2">

                <div class="bg-white dark:bg-slate-900
                            border border-slate-200 dark:border-slate-800
                            rounded-2xl shadow-sm p-6 md:p-8 h-full">


                    <h2 class="text-xl font-bold">

                        Password Anda

                    </h2>


                    <div class="relative mt-6">

                        <input
                            id="passwordOutput"
                            type="password"
                            readonly
                            class="w-full rounded-xl
                                   border border-slate-300
                                   dark:border-slate-700
                                   bg-slate-50
                                   dark:bg-slate-950
                                   px-4 py-4 pr-12
                                   font-mono text-lg">

                        <button
                            id="togglePasswordBtn"
                            type="button"
                            class="absolute right-3 top-1/2
                                   -translate-y-1/2
                                   text-lg">

                            👁

                        </button>

                    </div>


                    <!-- STRENGTH -->

                    <div class="mt-6">

                        <div class="flex justify-between text-sm">

                            <span class="font-semibold">

                                Kekuatan

                            </span>


                            <span>

                                <span
                                    id="strengthText">

                                    -

                                </span>

                                ·

                                <span
                                    id="strengthPercent">

                                    0%

                                </span>

                            </span>

                        </div>


                        <div class="h-2 bg-slate-200
                                    dark:bg-slate-800
                                    rounded-full mt-3 overflow-hidden">

                            <div
                                id="strengthBar"
                                class="h-full rounded-full
                                       bg-slate-400
                                       transition-all"
                                style="width: 0%">
                            </div>

                        </div>

                    </div>


                    <!-- ACTIONS -->

                    <div class="mt-8 space-y-3">

                        <button
                            id="copyPasswordBtn"
                            class="w-full px-5 py-3 rounded-xl
                                   bg-blue-600 text-white
                                   font-semibold
                                   hover:bg-blue-700">

                            Copy Password

                        </button>


                        <button
                            id="regeneratePasswordBtn"
                            class="w-full px-5 py-3 rounded-xl
                                   border border-slate-300
                                   dark:border-slate-700
                                   font-semibold
                                   hover:bg-slate-100
                                   dark:hover:bg-slate-800">

                            ↻ Generate Lagi

                        </button>

                    </div>


                    <div class="mt-6 p-4 rounded-xl
                                bg-emerald-50
                                dark:bg-emerald-950/30
                                text-sm text-emerald-800
                                dark:text-emerald-200">

                        🔒 Password dibuat langsung di browser
                        dan tidak dikirim ke server.

                    </div>

                </div>

            </div>

        </div>

    </section>

</main>

<!-- ===================================== -->
<!-- HASH GENERATOR -->
<!-- ===================================== -->

<section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-14">

    <div class="bg-white dark:bg-slate-900
                border border-slate-200
                dark:border-slate-800
                rounded-2xl
                shadow-sm
                p-6 md:p-8">


        <!-- HEADER -->

        <div class="flex items-start gap-4">

            <div class="w-12 h-12
                        rounded-xl
                        bg-violet-100
                        dark:bg-violet-950
                        flex items-center justify-center
                        text-2xl">

                🧬

            </div>


            <div>

                <h2 class="text-2xl font-bold">

                    Hash Generator

                </h2>


                <p class="mt-1 text-slate-500">

                    Ubah teks menjadi hash menggunakan
                    berbagai algoritma populer.

                </p>

            </div>

        </div>


        <!-- INPUT -->

        <div class="mt-8">

            <label
                for="hashInput"
                class="block text-sm font-semibold mb-2">

                Teks / Password

            </label>


            <textarea
                id="hashInput"
                rows="4"
                placeholder="Masukkan teks atau password..."
                class="w-full rounded-xl
                       border border-slate-300
                       dark:border-slate-700
                       bg-slate-50
                       dark:bg-slate-950
                       px-4 py-3
                       focus:ring-2
                       focus:ring-violet-500
                       outline-none"></textarea>


            <div class="flex justify-between mt-2">

                <span
                    id="hashCharCount"
                    class="text-xs text-slate-400">

                    0 karakter

                </span>


                <span
                    class="text-xs text-slate-400">

                    Diproses di browser

                </span>

            </div>

        </div>


        <!-- ALGORITHM -->

        <div class="mt-6">

            <label
                for="hashAlgorithm"
                class="block text-sm font-semibold mb-2">

                Algoritma Hash

            </label>


            <select
                id="hashAlgorithm"
                class="w-full rounded-xl
                       border border-slate-300
                       dark:border-slate-700
                       bg-white
                       dark:bg-slate-950
                       px-4 py-3
                       outline-none
                       focus:ring-2
                       focus:ring-violet-500">

                <option value="SHA-256">
                    SHA-256 — Recommended
                </option>

                <option value="SHA-512">
                    SHA-512
                </option>

                <option value="SHA-384">
                    SHA-384
                </option>

                <option value="SHA-224">
                    SHA-224
                </option>

                <option value="SHA3-256">
                    SHA3-256
                </option>

                <option value="SHA3-512">
                    SHA3-512
                </option>

                <option value="SHA3-384">
                    SHA3-384
                </option>

                <option value="SHA3-224">
                    SHA3-224
                </option>

                <option value="BLAKE2b">
                    BLAKE2b
                </option>

                <option value="BLAKE2s">
                    BLAKE2s
                </option>

                <option value="SHA-1">
                    SHA-1 — Legacy
                </option>

                <option value="MD5">
                    MD5 — Legacy
                </option>

            </select>

        </div>


        <!-- ERROR -->

        <p
            id="hashError"
            class="hidden mt-4
                   text-sm
                   text-red-500">
        </p>


        <!-- BUTTON -->

        <button
            id="generateHashBtn"
            class="w-full mt-6
                   px-5 py-3
                   rounded-xl
                   bg-violet-600
                   text-white
                   font-semibold
                   hover:bg-violet-700
                   transition">

            Generate Hash

        </button>


        <!-- OUTPUT -->

        <div class="mt-8">

            <div class="flex justify-between items-center">

                <label
                    class="text-sm font-semibold">

                    Hash Result

                </label>


                <span
                    id="hashInfo"
                    class="text-xs text-slate-400">

                    Belum ada hash

                </span>

            </div>


            <textarea
                id="hashOutput"
                rows="4"
                readonly
                placeholder="Hasil hash akan muncul di sini..."
                class="w-full mt-2
                       rounded-xl
                       border border-slate-300
                       dark:border-slate-700
                       bg-slate-50
                       dark:bg-slate-950
                       px-4 py-3
                       font-mono text-sm
                       break-all"></textarea>

        </div>


        <!-- ACTIONS -->

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4">

            <button
                id="copyHashBtn"
                class="px-5 py-3
                       rounded-xl
                       bg-blue-600
                       text-white
                       font-semibold
                       hover:bg-blue-700">

                Copy Hash

            </button>


            <button
                id="clearHashBtn"
                class="px-5 py-3
                       rounded-xl
                       border border-slate-300
                       dark:border-slate-700
                       font-semibold
                       hover:bg-slate-100
                       dark:hover:bg-slate-800">

                Bersihkan

            </button>

        </div>


        <!-- INFO -->

        <div class="mt-6
                    p-4
                    rounded-xl
                    bg-amber-50
                    dark:bg-amber-950/30
                    text-sm
                    text-amber-800
                    dark:text-amber-200">

            ⚠️ MD5 dan SHA-1 merupakan algoritma legacy
            dan tidak direkomendasikan untuk keamanan modern.
            Hash berbeda dengan enkripsi.

        </div>

    </div>

</section>
<script
    type="module"
    src="/assets/js/password-generator.js">
</script>

<script
    type="module"
    src="/assets/js/hash-generator.js">
</script>


<%- include('../partials/footer') %>