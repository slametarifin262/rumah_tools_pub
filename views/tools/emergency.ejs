<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kontak Darurat Terdekat</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Leaflet CSS & JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
</head>
<body class="bg-slate-50 min-h-screen flex flex-col">

    <!-- Header / Navbar -->
    <header class="bg-white border-b border-slate-200 px-6 py-4 flex justify-between items-center">
        <div class="flex items-center gap-3">
            <a href="/" class="text-slate-500 hover:text-slate-800"><i class="fa-solid fa-arrow-left text-lg"></i></a>
            <h1 class="font-bold text-slate-800 text-lg">Layanan Kontak Darurat Terdekat</h1>
        </div>
        <button id="btn-detect-location" onclick="detectUserLocation()" class="bg-red-600 hover:bg-red-700 text-white text-xs font-semibold px-4 py-2 rounded-xl flex items-center gap-2 shadow-sm transition">
            <i class="fa-solid fa-location-crosshairs"></i> Deteksi Lokasi Saya
        </button>
    </header>

    <!-- Main Content Grid -->
    <main class="flex-1 grid grid-cols-1 lg:grid-cols-12 gap-0 overflow-hidden">
        
        <!-- Peta Interaktif (7 cols di desktop) -->
        <div class="lg:col-span-7 h-[400px] lg:h-full relative">
            <div id="map" class="w-full h-full z-10"></div>
        </div>

        <!-- Panel List Kontak Darurat (5 cols di desktop) -->
        <div class="lg:col-span-5 bg-white border-l border-slate-200 p-6 overflow-y-auto max-h-[calc(100vh-73px)]">
            <div class="mb-4">
                <h2 class="font-bold text-slate-800 text-base">Rekomendasi Kontak Darurat</h2>
                <p class="text-xs text-slate-500 mt-1">Armada desa, ormas, dan puskesmas ditampilkan lebih dahulu berdasarkan koordinat Anda.</p>
            </div>

            <!-- Loader Status -->
            <div id="loading-state" class="hidden py-8 text-center text-slate-400">
                <i class="fa-solid fa-circle-notch fa-spin text-2xl mb-2 text-red-500"></i>
                <p class="text-xs">Mencari armada & layanan darurat terdekat...</p>
            </div>

            <!-- Container List Kontak -->
            <div id="contact-list" class="space-y-3">
                <div class="p-6 text-center border-2 border-dashed border-slate-200 rounded-2xl">
                    <i class="fa-solid fa-map-pin text-3xl text-slate-300 mb-2"></i>
                    <p class="text-xs text-slate-500">Klik tombol <b>"Deteksi Lokasi Saya"</b> untuk menampilkan info kontak darurat terdekat.</p>
                </div>
            </div>
        </div>
    </main>

    <script>
        // Inisialisasi Peta Leaflet (Default Posisi Indonesia/Jawa Tengah)
        let map = L.map('map').setView([-7.683, 109.002], 12);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap'
        }).addTo(map);

        let userMarker = null;
        let emergencyMarkers = [];

        // Deteksi Geolocation Browser
        function detectUserLocation() {
            if (navigator.geolocation) {
                document.getElementById('loading-state').classList.remove('hidden');
                document.getElementById('contact-list').innerHTML = '';

                navigator.geolocation.getCurrentPosition(position => {
                    const lat = position.coords.latitude;
                    const lng = position.coords.longitude;

                    // Update Peta Posisi User
                    map.setView([lat, lng], 14);

                    if (userMarker) map.removeLayer(userMarker);
                    userMarker = L.marker([lat, lng]).addTo(map)
                        .bindPopup("<b>Lokasi Anda Saat Ini</b>").openPopup();

                    // Ambil Data Kontak Darurat dari API
                    fetchEmergencyContacts(lat, lng);
                }, error => {
                    alert('Gagal mengambil lokasi. Pastikan izin GPS diizinkan di browser.');
                    document.getElementById('loading-state').classList.add('hidden');
                });
            } else {
                alert('Browser Anda tidak mendukung fitur Geolocation.');
            }
        }

        // Fetch Kontak dari Backend Express.js
        async function fetchEmergencyContacts(lat, lng) {
            try {
                const response = await fetch(`/api/emergency-contacts?lat=${lat}&lng=${lng}&radius=20`);
                const result = await response.json();

                document.getElementById('loading-state').classList.add('hidden');

                if (result.success && result.data.length > 0) {
                    renderContactsList(result.data);
                    renderMapMarkers(result.data);
                } else {
                    document.getElementById('contact-list').innerHTML = `
                        <div class="p-6 text-center text-slate-500 border rounded-2xl">
                            Tidak ditemukan kontak darurat dalam radius 20 KM.
                        </div>
                    `;
                }
            } catch (err) {
                console.error(err);
                document.getElementById('loading-state').classList.add('hidden');
            }
        }

        // Hapus marker darurat lama dari peta
        function clearEmergencyMarkers() {
            emergencyMarkers.forEach(m => map.removeLayer(m));
            emergencyMarkers = [];
        }

        // Render Marker Kontak di Peta
        function renderMapMarkers(contacts) {
            clearEmergencyMarkers();

            contacts.forEach(c => {
                const marker = L.marker([c.latitude, c.longitude]).addTo(map);
                marker.bindPopup(`
                    <div class="p-1">
                        <span class="text-[10px] uppercase font-bold text-red-600">${c.category.replace('_', ' ')}</span>
                        <h4 class="font-bold text-sm text-slate-800">${c.name}</h4>
                        <p class="text-xs text-slate-500 mb-2">Jarak: ${parseFloat(c.distance_km).toFixed(2)} km</p>
                        <a href="tel:${c.phone_number}" class="bg-red-600 text-white text-xs px-3 py-1 rounded-lg block text-center font-bold">Telepon</a>
                    </div>
                `);
                emergencyMarkers.push(marker);
            });
        }

        // Render Card List Kontak Darurat di Sidebar
        function renderContactsList(contacts) {
            const listContainer = document.getElementById('contact-list');
            listContainer.innerHTML = '';

            contacts.forEach(item => {
                const isLocalUnit = item.tier_level === 1;
                
                const cardHtml = `
                    <div class="bg-white border ${isLocalUnit ? 'border-red-200 bg-red-50/20' : 'border-slate-200'} p-4 rounded-2xl shadow-sm hover:shadow-md transition">
                        <div class="flex items-start justify-between">
                            <div>
                                <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full ${isLocalUnit ? 'bg-red-100 text-red-700' : 'bg-slate-100 text-slate-600'}">
                                    ${item.category.replace('_', ' ')}
                                </span>
                                <h3 class="font-bold text-slate-800 text-sm mt-1">${item.name}</h3>
                                <p class="text-xs text-slate-500 mt-0.5"><i class="fa-solid fa-route text-slate-400 mr-1"></i> ${parseFloat(item.distance_km).toFixed(2)} km dari lokasi Anda</p>
                            </div>
                            ${isLocalUnit ? '<span class="text-[10px] bg-emerald-100 text-emerald-700 px-2 py-0.5 font-bold rounded-full">Rekomendasi</span>' : ''}
                        </div>

                        <div class="mt-3 pt-3 border-t border-slate-100 flex items-center gap-2">
                            <a href="tel:${item.phone_number}" class="flex-1 bg-red-600 hover:bg-red-700 text-white text-xs font-semibold py-2 rounded-xl text-center flex items-center justify-center gap-1">
                                <i class="fa-solid fa-phone"></i> Telepon
                            </a>
                            ${item.whatsapp_number ? `
                                <a href="https://wa.me/${item.whatsapp_number}" target="_blank" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold py-2 rounded-xl text-center flex items-center justify-center gap-1">
                                    <i class="fa-brands fa-whatsapp"></i> WhatsApp
                                </a>
                            ` : ''}
                            <a href="https://www.google.com/maps/dir/?api=1&destination=${item.latitude},${item.longitude}" target="_blank" class="px-3 py-2 border border-slate-200 hover:bg-slate-100 rounded-xl text-slate-600 text-xs">
                                <i class="fa-solid fa-diamond-turn-right"></i>
                            </a>
                        </div>
                    </div>
                `;
                listContainer.insertAdjacentHTML('beforeend', cardHtml);
            });
        }
    </script>
</body>
</html>