<%- include('../partials/header') %>

<%- include('../partials/navbar') %>


<main class="flex-1">


    <!-- HERO -->

    <section
        class="bg-gradient-to-br
               from-blue-600
               via-indigo-600
               to-violet-700
               text-white">

        <div
            class="max-w-5xl mx-auto
                   px-4 sm:px-6 lg:px-8
                   py-12 md:py-16">

            <a
                href="/tools"
                class="text-sm
                       text-blue-100
                       hover:text-white">

                ← Kembali ke Semua Tools

            </a>


            <div
                class="mt-8
                       flex items-start
                       gap-5">

                <div
                    class="w-16 h-16
                           rounded-2xl
                           bg-white/15
                           flex items-center
                           justify-center
                           text-3xl">

                    🔢

                </div>


                <div>

                    <h1
                        class="text-3xl
                               md:text-4xl
                               font-bold">

                        Number to Text

                    </h1>


                    <p
                        class="mt-3
                               text-blue-100
                               max-w-2xl">

                        Konversi angka menjadi tulisan
                        bahasa Indonesia dengan mudah.

                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- TOOL -->

    <section
        class="max-w-5xl mx-auto
               px-4 sm:px-6 lg:px-8
               py-10 md:py-14">


        <div
            class="bg-white
                   dark:bg-slate-900
                   border border-slate-200
                   dark:border-slate-800
                   rounded-2xl
                   shadow-sm
                   p-6 md:p-8">


            <h2
                class="text-xl
                       font-bold">

                Konversi Angka

            </h2>


            <p
                class="mt-2
                       text-slate-500">

                Contoh:
                100.000 → seratus ribu

            </p>


            <!-- INPUT -->

            <div class="mt-7">

                <label
                    for="numberInput"
                    class="block
                           text-sm
                           font-semibold
                           mb-2">

                    Masukkan Angka

                </label>


                <input
                    id="numberInput"
                    type="text"
                    inputmode="decimal"
                    placeholder="Contoh: 1.250.000"
                    class="w-full
                           rounded-xl
                           border
                           border-slate-300
                           dark:border-slate-700
                           bg-slate-50
                           dark:bg-slate-950
                           px-4 py-4
                           text-lg
                           font-mono
                           outline-none
                           focus:ring-2
                           focus:ring-blue-500">


                <p
                    class="mt-2
                           text-xs
                           text-slate-400">

                    Gunakan titik sebagai pemisah
                    ribuan dan koma untuk desimal.

                </p>

            </div>


            <!-- CURRENCY -->

             <!-- OPTIONS -->

            <div class="mt-6">

                <label
                    for="currency"
                    class="block
                           text-sm
                           font-semibold
                           mb-2">

                    Format Hasil

                </label>


                <select
                    id="currency"
                    class="w-full
                           rounded-xl
                           border
                           border-slate-300
                           dark:border-slate-700
                           bg-white
                           dark:bg-slate-950
                           px-4 py-3">

                    <option value="NONE">
                        Angka biasa
                    </option>

                    <option value="IDR">
                        Rupiah (Rp)
                    </option>

                </select>

            </div>


            <!-- PRO OPTIONS -->

            <div
                class="mt-6
                       grid
                       grid-cols-1
                       md:grid-cols-3
                       gap-3">


                <label
                    class="flex
                           items-center
                           gap-3
                           p-4
                           rounded-xl
                           border
                           border-slate-200
                           dark:border-slate-700
                           cursor-pointer
                           hover:bg-slate-50
                           dark:hover:bg-slate-800">

                    <input
                        id="useSen"
                        type="checkbox"
                        checked
                        class="w-4 h-4">

                    <span>

                        <span class="block font-semibold">
                            Gunakan Sen
                        </span>

                        <span
                            class="block
                                   text-xs
                                   text-slate-500">

                            Untuk angka desimal Rupiah

                        </span>

                    </span>

                </label>


                <label
                    class="flex
                           items-center
                           gap-3
                           p-4
                           rounded-xl
                           border
                           border-slate-200
                           dark:border-slate-700
                           cursor-pointer
                           hover:bg-slate-50
                           dark:hover:bg-slate-800">

                    <input
                        id="capitalizeResult"
                        type="checkbox"
                        class="w-4 h-4">

                    <span>

                        <span class="block font-semibold">
                            Huruf Awal Kapital
                        </span>

                        <span
                            class="block
                                   text-xs
                                   text-slate-500">

                            Cocok untuk dokumen

                        </span>

                    </span>

                </label>


                <label
                    class="flex
                           items-center
                           gap-3
                           p-4
                           rounded-xl
                           border
                           border-blue-200
                           bg-blue-50
                           dark:bg-blue-950/30
                           dark:border-blue-800
                           cursor-pointer">

                    <input
                        id="officialFormat"
                        type="checkbox"
                        class="w-4 h-4">

                    <span>

                        <span class="block font-semibold">
                            Format Dokumen
                        </span>

                        <span
                            class="block
                                   text-xs
                                   text-slate-500">

                            Kapitalisasi hasil

                        </span>

                    </span>

                </label>

            </div>


            <!-- ERROR -->

            <p
                id="numberError"
                class="hidden
                       mt-4
                       text-sm
                       text-red-500">
            </p>


            <!-- BUTTON -->

            <button
                id="generateNumberTextBtn"
                class="w-full
                       mt-7
                       px-5 py-3
                       rounded-xl
                       bg-blue-600
                       text-white
                       font-semibold
                       hover:bg-blue-700
                       transition">

                Ubah Menjadi Tulisan

            </button>


            <!-- RESULT -->

            <div class="mt-8">

                <div
                    class="flex
                           justify-between
                           items-center">

                    <label
                        class="text-sm
                               font-semibold">

                        Hasil Terbilang

                    </label>


                    <span
                        class="text-xs
                               text-slate-400">

                        Bahasa Indonesia

                    </span>

                </div>


                <textarea
                    id="numberResult"
                    rows="4"
                    readonly
                    placeholder="Hasil akan muncul di sini..."
                    class="w-full
                           mt-2
                           rounded-xl
                           border
                           border-slate-300
                           dark:border-slate-700
                           bg-slate-50
                           dark:bg-slate-950
                           px-4 py-3
                           text-lg
                           resize-none"></textarea>

            </div>


            <!-- ACTION -->

            <div
                class="grid
                       grid-cols-1
                       sm:grid-cols-2
                       gap-3
                       mt-4">


                <button
                    id="copyNumberTextBtn"
                    class="px-5 py-3
                           rounded-xl
                           bg-emerald-600
                           text-white
                           font-semibold
                           hover:bg-emerald-700">

                    Copy Hasil

                </button>


                <button
                    id="clearNumberTextBtn"
                    class="px-5 py-3
                           rounded-xl
                           border
                           border-slate-300
                           dark:border-slate-700
                           font-semibold
                           hover:bg-slate-100
                           dark:hover:bg-slate-800">

                    Bersihkan

                </button>

            </div>
            <!-- BULK CONVERTER -->

            <div
                class="mt-10
                       border-t
                       border-slate-200
                       dark:border-slate-800
                       pt-8">

                <div class="flex items-start gap-4">

                    <div
                        class="w-12 h-12
                               rounded-xl
                               bg-emerald-100
                               dark:bg-emerald-950
                               flex items-center
                               justify-center
                               text-emerald-600
                               font-bold">

                        XLS

                    </div>

                    <div>

                        <h3 class="text-lg font-bold">
                            Konversi Banyak Data
                        </h3>

                        <p class="mt-1 text-sm text-slate-500">
                            Upload CSV untuk mengubah banyak angka
                            menjadi tulisan sekaligus.
                        </p>

                    </div>

                </div>


                <!-- FILE -->

                <div class="mt-6">

                    <label
                        for="bulkFile"
                        class="block
                               text-sm
                               font-semibold
                               mb-2">

                        File CSV / Excel

                    </label>

                        <!-- accept=".csv,text/csv" -->
                    <input
                        id="bulkFile"
                        type="file"
                        accept=".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                        class="w-full
                               rounded-xl
                               border
                               border-slate-300
                               dark:border-slate-700
                               bg-slate-50
                               dark:bg-slate-950
                               px-4 py-3">

                    <p class="mt-2 text-xs text-slate-400">
                        Format yang didukung: CSV dan Excel (.xlsx).
                    </p>

                </div>


                <!-- COLUMN -->

                <div
                    id="bulkColumnArea"
                    class="hidden mt-6">

                    <label
                        for="bulkColumn"
                        class="block
                               text-sm
                               font-semibold
                               mb-2">

                        Kolom Angka

                    </label>

                    <select
                        id="bulkColumn"
                        class="w-full
                               rounded-xl
                               border
                               border-slate-300
                               dark:border-slate-700
                               bg-white
                               dark:bg-slate-950
                               px-4 py-3">
                    </select>

                </div>


                <!-- OPTIONS -->

                <div
                    id="bulkOptions"
                    class="hidden
                           mt-6
                           grid
                           grid-cols-1
                           md:grid-cols-2
                           gap-3">

                    <label
                        class="flex items-center gap-3
                               p-4 rounded-xl
                               border
                               border-slate-200
                               dark:border-slate-700">

                        <input
                            id="bulkRupiah"
                            type="checkbox"
                            class="w-4 h-4">

                        <span>
                            <span class="block font-semibold">
                                Tambahkan Rupiah
                            </span>

                            <span class="block text-xs text-slate-500">
                                Contoh: seratus ribu rupiah
                            </span>
                        </span>

                    </label>


                    <label
                        class="flex items-center gap-3
                               p-4 rounded-xl
                               border
                               border-slate-200
                               dark:border-slate-700">

                        <input
                            id="bulkCapital"
                            type="checkbox"
                            class="w-4 h-4">

                        <span>
                            <span class="block font-semibold">
                                Huruf Awal Kapital
                            </span>

                            <span class="block text-xs text-slate-500">
                                Cocok untuk dokumen resmi
                            </span>
                        </span>

                    </label>

                </div>


                <!-- PROCESS -->

                <button
                    id="bulkProcessBtn"
                    disabled
                    class="w-full
                           mt-6
                           px-5 py-3
                           rounded-xl
                           bg-emerald-600
                           text-white
                           font-semibold
                           hover:bg-emerald-700
                           disabled:opacity-40
                           disabled:cursor-not-allowed">

                    Proses Data

                </button>


                <!-- PREVIEW -->

                <div
                    id="bulkPreviewArea"
                    class="hidden mt-8">

                    <div
                        class="flex
                               items-center
                               justify-between
                               mb-3">

                        <h4 class="font-bold">
                            Preview Hasil
                        </h4>

                        <span
                            id="bulkCount"
                            class="text-xs text-slate-400">
                        </span>

                    </div>


                    <div
                        class="overflow-x-auto
                               rounded-xl
                               border
                               border-slate-200
                               dark:border-slate-700">

                        <table
                            class="w-full
                                   text-sm">

                            <thead
                                id="bulkTableHead"
                                class="bg-slate-100
                                       dark:bg-slate-800">
                            </thead>

                            <tbody
                                id="bulkTableBody">
                            </tbody>

                        </table>

                    </div>


                    <button
                        id="bulkDownloadBtn"
                        class="w-full
                               mt-4
                               px-5 py-3
                               rounded-xl
                               bg-blue-600
                               text-white
                               font-semibold
                               hover:bg-blue-700">

                        Download CSV Hasil

                    </button>
                    <button
                        id="downloadExcelBtn"
                        type="button"
                        class="hidden
                               w-full
                               mt-3
                               px-5 py-3
                               rounded-xl
                               bg-emerald-600
                               text-white
                               font-semibold
                               hover:bg-emerald-700
                               transition">

                        Download Excel Hasil (.xlsx)

                    </button>
                    <button
                        id="bulkDownloadExcelBtn"
                        type="button"
                        class=" 
                               w-full
                               mt-3
                               px-5 py-3
                               rounded-xl
                               bg-emerald-600
                               text-white
                               font-semibold
                               hover:bg-emerald-700
                               transition">

                        Download Excel Hasil (.xlsx)

                    </button>

                </div>

            </div>


            <!-- EXAMPLES -->

            <div
                class="mt-8
                       grid
                       grid-cols-1
                       md:grid-cols-3
                       gap-4">


                <div
                    class="p-4
                           rounded-xl
                           bg-slate-50
                           dark:bg-slate-950">

                    <div
                        class="font-mono
                               font-bold">

                        100.000

                    </div>

                    <div
                        class="mt-1
                               text-sm
                               text-slate-500">

                        seratus ribu

                    </div>

                </div>


                <div
                    class="p-4
                           rounded-xl
                           bg-slate-50
                           dark:bg-slate-950">

                    <div
                        class="font-mono
                               font-bold">

                        1.250.000

                    </div>

                    <div
                        class="mt-1
                               text-sm
                               text-slate-500">

                        satu juta dua ratus lima puluh ribu

                    </div>

                </div>


                <div
                    class="p-4
                           rounded-xl
                           bg-slate-50
                           dark:bg-slate-950">

                    <div
                        class="font-mono
                               font-bold">

                        Rp 100.000

                    </div>

                    <div
                        class="mt-1
                               text-sm
                               text-slate-500">

                        seratus ribu rupiah

                    </div>

                </div>

            </div>

        </div>

    </section>

</main>
<script src="https://cdn.jsdelivr.net/npm/read-excel-file@5.8.6/bundle/read-excel-file.min.js"></script>
<!-- <script src="https://cdn.jsdelivr.net/npm/write-excel-file@1.4.30/dist/write-excel-file.min.js"></script> -->

<script
    type="module"
    src="/assets/js/number-to-text.js">
</script> 
<script
    type="module"
    src="/assets/js/number-to-text-bulk.js">
</script>
<!-- <script
    src="/assets/js/number-to-text-bulk.js">
</script>-->


<%- include('../partials/footer') %>