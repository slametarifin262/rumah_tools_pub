        function finishMatchAndShowChart() {
            if (scoreLogs.length === 0) {
                alert("Belum ada skor yang tercatat untuk dianalisis!");
                return;
            }

            if (isTimerRunning) toggleTimer();

            const nameA = document.getElementById('nameTeamA').value || 'TIM A';
            const nameB = document.getElementById('nameTeamB').value || 'TIM B';
            const sportType = document.getElementById('presetSelect').value;
            const duration = getFormattedTimer();

            let winnerText = 'SERI';
            if (state.scoreA > state.scoreB) winnerText = nameA;
            if (state.scoreB > state.scoreA) winnerText = nameB;

            // ========================================================
            // OTOMATIS SIMPAN KE DATABASE MYSQL VIA FETCH API
            // ========================================================
            fetch('/api/papan-skor/save', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    teamA: nameA,
                    teamB: nameB,
                    scoreA: state.scoreA,
                    scoreB: state.scoreB,
                    sportType: sportType,
                    matchDuration: duration,
                    winner: winnerText,
                    scoreLogs: scoreLogs
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    console.log("✅ Pertandingan berhasil disimpan ke database!");
                }
            })
            .catch(err => console.error("❌ Error simpan DB:", err));

            // 1. Tampilkan Banner Pemenang
            const winnerBanner = document.getElementById('winnerBanner');
            if (state.scoreA > state.scoreB) {
                winnerBanner.innerHTML = `<span class="text-red-400 font-bold text-lg">🏆 HASIL AKHIR: ${nameA} MENANG!</span> <span class="text-gray-400">(${state.scoreA} - ${state.scoreB})</span>`;
            } else if (state.scoreB > state.scoreA) {
                winnerBanner.innerHTML = `<span class="text-blue-400 font-bold text-lg">🏆 HASIL AKHIR: ${nameB} MENANG!</span> <span class="text-gray-400">(${state.scoreB} - ${state.scoreA})</span>`;
            } else {
                winnerBanner.innerHTML = `<span class="text-amber-400 font-bold text-lg">🤝 HASIL AKHIR: SERI!</span> <span class="text-gray-400">(${state.scoreA} - ${state.scoreB})</span>`;
            }

            // 2. Render Grafik Chart.js
            const chronologicalLogs = scoreLogs.slice().reverse();
            const labels = ['00:00', ...chronologicalLogs.map(log => log.time)];
            const dataA = [0];
            const dataB = [0];

            let currentA = 0;
            let currentB = 0;

            chronologicalLogs.forEach(log => {
                if (log.teamCode === 'A') currentA += log.point;
                if (log.teamCode === 'B') currentB += log.point;
                dataA.push(currentA);
                dataB.push(currentB);
            });

            const ctx = document.getElementById('scoreChart').getContext('2d');
            if (chartInstance) chartInstance.destroy();

            chartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: nameA,
                            data: dataA,
                            borderColor: '#ef4444',
                            backgroundColor: 'rgba(239, 68, 68, 0.1)',
                            stepped: true,
                            borderWidth: 3,
                            pointRadius: 4,
                            pointBackgroundColor: '#ef4444'
                        },
                        {
                            label: nameB,
                            data: dataB,
                            borderColor: '#3b82f6',
                            backgroundColor: 'rgba(59, 130, 246, 0.1)',
                            stepped: true,
                            borderWidth: 3,
                            pointRadius: 4,
                            pointBackgroundColor: '#3b82f6'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: { title: { display: true, text: 'Waktu Pertandingan', color: '#9ca3af' }, ticks: { color: '#9ca3af' }, grid: { color: '#374151' } },
                        y: { title: { display: true, text: 'Akumulasi Skor', color: '#9ca3af' }, ticks: { color: '#9ca3af', stepSize: 1 }, grid: { color: '#374151' }, beginAtZero: true }
                    }
                }
            });

            document.getElementById('analysisModal').classList.remove('hidden');
        }

        function closeAnalysisModal() {
            document.getElementById('analysisModal').classList.add('hidden');
        }

        renderTimer();
    </script>
</body>
</html>

