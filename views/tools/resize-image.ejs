<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="py-8 bg-gray-50 min-h-screen">
    <div class="w-full lg:w-3/4 max-w-5xl mx-auto px-4">

        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8 mb-6">
            <h1 class="text-2xl font-bold text-gray-900 mb-1">Resize & Kompres Gambar</h1>
            <p class="text-sm text-gray-500 mb-6">Ubah ukuran (dimensi) dan kompres gambar Anda untuk menghemat kapasitas penyimpanan, tanpa kehilangan banyak kualitas.</p>

            <form id="resizeForm">
                <input type="hidden" name="_csrf" id="csrfInput" value="<%= csrfToken %>">

                <!-- Drop Zone -->
                <div
                    id="dropZone"
                    class="border-2 border-dashed border-gray-300 hover:border-amber-800 rounded-2xl p-6 text-center bg-gray-50 hover:bg-amber-50/20 transition cursor-pointer mb-4"
                >
                    <svg class="mx-auto h-10 w-10 text-gray-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    <p id="fileName" class="text-sm font-semibold text-gray-700 mb-1">Klik atau seret foto ke sini</p>
                    <p class="text-xs text-gray-400">Format: JPG, PNG, WEBP (Maksimal 20MB)</p>

                    <input
                        type="file"
                        name="photo"
                        id="photoInput"
                        accept="image/png, image/jpeg, image/webp"
                        required
                        class="hidden"
                    >
                </div>

                <!-- Preview -->
                <div id="initialPreviewContainer" class="hidden mb-6 text-center border-t border-gray-100 pt-4">
                    <p class="text-xs font-bold text-gray-500 uppercase mb-2">Pratinjau &amp; Dimensi Asli:</p>
                    <div class="inline-block bg-gray-100 p-2 rounded-xl border border-gray-200">
                        <img id="initialPreview" src="" alt="Pratinjau" class="max-h-56 rounded-lg object-contain">
                    </div>
                    <p id="originalDims" class="text-xs text-gray-500 mt-2"></p>
                </div>

                <!-- Pengaturan Resize & Kompresi -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                    <div class="space-y-4">
                        <div>
                            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Skala Persentase:</label>
                            <select name="scale_percent" id="scaleSelect" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 text-sm text-gray-900 bg-white focus:outline-none focus:border-amber-800">
                                <option value="">Gunakan dimensi manual di bawah</option>
                                <option value="25">25% (perkecil)</option>
                                <option value="50" selected>50% (perkecil)</option>
                                <option value="75">75% (perkecil)</option>
                                <option value="150">150% (perbesar)</option>
                                <option value="200">200% (perbesar)</option>
                            </select>
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Lebar (px):</label>
                                <input type="number" name="width" id="widthInput" placeholder="auto" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 text-sm text-gray-900 bg-white focus:outline-none focus:border-amber-800">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Tinggi (px):</label>
                                <input type="number" name="height" id="heightInput" placeholder="auto" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 text-sm text-gray-900 bg-white focus:outline-none focus:border-amber-800">
                            </div>
                        </div>
                        <p class="text-[11px] text-gray-500">Isi Lebar/Tinggi manual akan mengabaikan pilihan Skala Persentase di atas.</p>
                    </div>

                    <div class="space-y-4">
                        <div>
                            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Format Output:</label>
                            <select name="format" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 text-sm text-gray-900 bg-white focus:outline-none focus:border-amber-800">
                                <option value="jpeg" selected>JPG</option>
                                <option value="png">PNG</option>
                                <option value="webp">WEBP</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Mode Ukuran:</label>
                            <select name="fit" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 text-sm text-gray-900 bg-white focus:outline-none focus:border-amber-800">
                                <option value="inside" selected>Jaga rasio aspek (inside)</option>
                                <option value="cover">Penuhi bingkai (cover)</option>
                                <option value="fill">Regangkan penuh (fill)</option>
                            </select>
                        </div>
                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <label class="text-xs font-bold text-gray-700 uppercase">Kualitas Kompresi:</label>
                                <span id="qualityVal" class="text-xs font-semibold text-gray-700">80%</span>
                            </div>
                            <input
                                type="range"
                                name="quality"
                                min="10"
                                max="100"
                                step="5"
                                value="80"
                                oninput="document.getElementById('qualityVal').innerText = this.value + '%'"
                                class="w-full accent-amber-800"
                            >
                        </div>
                    </div>
                </div>

                <button
                    type="submit"
                    id="processBtn"
                    class="w-full bg-amber-800 hover:bg-amber-900 text-white font-semibold text-sm py-3 px-6 rounded-xl transition shadow-sm disabled:bg-gray-300 disabled:cursor-not-allowed"
                    disabled
                >
                    Proses Resize & Kompres
                </button>
            </form>

            <!-- Loading Spinner -->
            <div id="loadingState" class="hidden text-center py-8">
                <div class="inline-block animate-spin rounded-full h-10 w-10 border-4 border-amber-800 border-t-transparent mb-3"></div>
                <p class="text-sm font-semibold text-gray-700">Sedang memproses gambar Anda...</p>
            </div>

            <!-- Pesan Error -->
            <div id="errorState" class="hidden mt-4 p-4 rounded-xl bg-red-50 border border-red-200 text-sm text-red-700"></div>
        </div>

        <!-- Section Hasil -->
        <div id="resultContainer" class="hidden bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8">
            <h2 class="text-lg font-bold text-gray-900 mb-4">Hasil Gambar</h2>
            <div class="text-center">
                <div class="inline-block bg-gray-100 p-2 rounded-xl border border-gray-200">
                    <img id="resultPreview" src="" alt="Hasil" class="max-h-96 object-contain rounded-lg max-w-full">
                </div>
                <p id="resultSummary" class="text-sm text-gray-500 mt-3"></p>
            </div>
            <div class="mt-6 text-center">
                <a
                    id="downloadBtn"
                    href="#"
                    download="gambar_hasil.jpg"
                    class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm py-3 px-8 rounded-xl transition shadow-sm inline-flex items-center gap-2"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                    Download Gambar Hasil
                </a>
            </div>
        </div>

    </div>
</main>

<script>
    const dropZone = document.getElementById('dropZone');
    const photoInput = document.getElementById('photoInput');
    const fileNameLabel = document.getElementById('fileName');
    const processBtn = document.getElementById('processBtn');
    const resizeForm = document.getElementById('resizeForm');
    const loadingState = document.getElementById('loadingState');
    const errorState = document.getElementById('errorState');
    const resultContainer = document.getElementById('resultContainer');
    const resultPreview = document.getElementById('resultPreview');
    const resultSummary = document.getElementById('resultSummary');
    const downloadBtn = document.getElementById('downloadBtn');
    const initialPreviewContainer = document.getElementById('initialPreviewContainer');
    const initialPreview = document.getElementById('initialPreview');
    const originalDims = document.getElementById('originalDims');
    const widthInput = document.getElementById('widthInput');
    const heightInput = document.getElementById('heightInput');
    const scaleSelect = document.getElementById('scaleSelect');

    dropZone.addEventListener('click', () => photoInput.click());

    // Kosongkan Lebar/Tinggi manual saat Skala Persentase dipilih, dan sebaliknya
    scaleSelect.addEventListener('change', () => {
        if (scaleSelect.value) { widthInput.value = ''; heightInput.value = ''; }
    });
    [widthInput, heightInput].forEach(el => el.addEventListener('input', () => {
        if (el.value) scaleSelect.value = '';
    }));

    photoInput.addEventListener('change', () => {
        const file = photoInput.files[0];
        if (file) {
            processBtn.disabled = false;
            fileNameLabel.innerText = `File Terpilih: ${file.name}`;
            const url = URL.createObjectURL(file);
            initialPreview.src = url;
            initialPreview.onload = () => {
                originalDims.innerText = `${initialPreview.naturalWidth} x ${initialPreview.naturalHeight}px — ${(file.size / 1024).toFixed(1)} KB`;
            };
            initialPreviewContainer.classList.remove('hidden');
        } else {
            processBtn.disabled = true;
            initialPreviewContainer.classList.add('hidden');
        }
    });

    resizeForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const formData = new FormData(resizeForm);

        loadingState.classList.remove('hidden');
        errorState.classList.add('hidden');
        resultContainer.classList.add('hidden');
        processBtn.disabled = true;

        try {
            const response = await fetch('/tools/process-resize-image', {
                method: 'POST',
                body: formData
            });

            if (!response.ok) {
                const errData = await response.json().catch(() => ({}));
                throw new Error(errData.message || 'Gagal memproses gambar.');
            }

            const blob = await response.blob();
            const url = URL.createObjectURL(blob);

            resultPreview.src = url;
            resultSummary.innerText = `Ukuran file hasil: ${(blob.size / 1024).toFixed(1)} KB`;
            downloadBtn.href = url;
            resultContainer.classList.remove('hidden');
            resultContainer.scrollIntoView({ behavior: 'smooth' });
        } catch (err) {
            console.error(err);
            errorState.innerText = err.message || 'Terjadi kesalahan saat memproses gambar.';
            errorState.classList.remove('hidden');
        } finally {
            loadingState.classList.add('hidden');
            processBtn.disabled = false;
        }
    });
</script>

<%- include('../partials/footer') %>
